# Maintainer: RAprogramm <andrey.rozanov.vl@gmail.com>
pkgname=logi-mx-bin
pkgver=0.5.0
pkgrel=1
pkgdesc="Logitech MX Master 3S configuration tool and daemon with system tray (binary package)"
arch=('x86_64')
url="https://github.com/RAprogramm/logi-mx"
license=('MIT')
depends=('hidapi' 'systemd' 'gtk4' 'libadwaita' 'dbus')
provides=('logi-mx')
conflicts=('logi-mx')
source=("$pkgname-$pkgver.tar.gz::https://github.com/RAprogramm/logi-mx/releases/download/v${pkgver}/logi-mx-${pkgver}-x86_64-linux-gnu.tar.gz")
sha256sums=('SKIP')

package() {
    # Install binaries
    install -Dm755 logi-mx "$pkgdir/usr/bin/logi-mx"
    install -Dm755 logi-mx-daemon "$pkgdir/usr/bin/logi-mx-daemon"
    install -Dm755 logi-mx-ui "$pkgdir/usr/bin/logi-mx-ui"
    install -Dm755 logi-mx-overlay "$pkgdir/usr/bin/logi-mx-overlay"

    # Install udev rules
    install -Dm644 90-logi-mx.rules "$pkgdir/usr/lib/udev/rules.d/90-logi-mx.rules"

    # Install systemd user units
    install -Dm644 logi-mx-daemon.service "$pkgdir/usr/lib/systemd/user/logi-mx-daemon.service"
    install -Dm644 logi-mx-daemon.socket "$pkgdir/usr/lib/systemd/user/logi-mx-daemon.socket"
    install -Dm644 logi-mx-overlay.service "$pkgdir/usr/lib/systemd/user/logi-mx-overlay.service"
    sed -i "s#^ExecStart=.*#ExecStart=/usr/bin/logi-mx-overlay#" "$pkgdir/usr/lib/systemd/user/logi-mx-overlay.service"

    # Install desktop files
    install -Dm644 logi-mx-daemon.desktop "$pkgdir/usr/share/applications/logi-mx-daemon.desktop"
    install -Dm644 logi-mx-ui.desktop "$pkgdir/usr/share/applications/logi-mx-ui.desktop"

    # Install documentation
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"

    # Install license
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
